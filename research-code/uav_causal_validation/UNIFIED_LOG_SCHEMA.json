    "packet_loss", "information_residual", "task_margin",
    "inter_agent_clearance", "obstacle_clearance", "target_reachable",
    "completion", "collision_event", "failure_dwell", "recovery_dwell",
    "control_energy", "communication_messages", "solver_status",
    "solver_time", "gate_switch_reason"
