        "run_level_failures",
        "interpretation_prohibitions",
        "delete_failed_runs",
        "retune_after_primary",
        "hardware_replacement_policy"
      ],
      "properties": {
        "pre_primary_blockers": {
          "$ref": "#/$defs/nonemptyStrings"
        },
        "run_level_failures": {
          "$ref": "#/$defs/nonemptyStrings"
        },
        "interpretation_prohibitions": {
          "$ref": "#/$defs/nonemptyStrings"
        },
        "delete_failed_runs": {
          "const": false
        },
        "retune_after_primary": {
          "const": false
        },
        "hardware_replacement_policy": {
          "const": "new_node_id_and_repeat_calibration_identification_confirmation"
        }
      }
    },
    "raw_field_contract": {
