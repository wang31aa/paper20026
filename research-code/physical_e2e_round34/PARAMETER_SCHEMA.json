  },
  "$defs": {
    "positive": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "nonnegative": {
      "type": "number",
      "minimum": 0
    },
    "nonnegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "interval": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number"
      }
    },
    "matrix": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "number"
        }
      }
    },
    "systemMatrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode_id",
        "vertex_id",
        "F"
      ],
      "properties": {
        "mode_id": {
          "type": "string",
          "minLength": 1
        },
        "vertex_id": {
          "type": "string",
          "minLength": 1
        },
        "F": {
          "$ref": "#/$defs/matrix"
        }
      }
    },
    "versionedComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "commit",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "minLength": 7
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "role",
        "hardware_serial",
        "motor_serial",
        "encoder_serial",
        "teensy_model",
        "driver_model",
        "calibration_manifest_sha256"
      ],
      "properties": {
        "node_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "role": {
          "type": "string",
          "enum": [
            "physical_leader",
            "physical_follower"
          ]
        },
        "hardware_serial": {
          "type": "string",
          "minLength": 1
        },
        "motor_serial": {
          "type": "string",
          "minLength": 1
        },
        "encoder_serial": {
          "type": "string",
          "minLength": 1
        },
        "teensy_model": {
          "type": "string",
          "pattern": "^Teensy 4"
        },
        "driver_model": {
          "const": "DRV8874"
        },
        "calibration_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "nodeModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "a_interval",
        "b_interval",
        "c_interval",
        "w_abs_max",
        "input_delay_modes",
        "identification_method",
        "identification_code_sha256",
        "identification_output_sha256"
      ],
      "properties": {
        "node_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "a_interval": {
          "$ref": "#/$defs/interval"
        },
        "b_interval": {
          "$ref": "#/$defs/interval"
        },
        "c_interval": {
          "$ref": "#/$defs/interval"
        },
        "w_abs_max": {
          "$ref": "#/$defs/nonnegative"
        },
        "input_delay_modes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          }
        },
        "identification_method": {
          "type": "string",
          "minLength": 1
        },
        "identification_code_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "identification_output_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "nominalModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "a_nominal",
        "b_nominal",
        "c_nominal"
      ],
      "properties": {
        "node_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "a_nominal": {
          "type": "number"
        },
        "b_nominal": {
          "$ref": "#/$defs/positive"
        },
        "c_nominal": {
          "type": "number"
        }
      }
    },
    "runIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "type",
        "definition_sha256",
        "amplitude_abs_max",
        "frequency_Hz_max"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "step_sequence",
            "multisine",
            "chirp",
            "aprbs"
          ]
        },
        "definition_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "amplitude_abs_max": {
          "$ref": "#/$defs/positive"
        },
        "frequency_Hz_max": {
          "$ref": "#/$defs/positive"
        }
      }
    },
    "nonemptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "x-semanticChecks": [
    "Exactly one apparatus node has role physical_leader and node_id 0; exactly two have role physical_follower and node_id 1 or 2; all node and hardware identities are unique.",
    "All interval arrays are ordered lower <= upper; every nominal parameter lies inside its interval; every b interval has lower endpoint > 0.",
    "Model and nominal node_id sets are exactly {0,1,2}.",
    "The dimensions of P are augmented_state_order by augmented_state_order, every row has equal length, P is symmetric, trace(P)=1, and an independent rigorous checker verifies positive definiteness.",
    "system_matrices contains exactly vertex_count * mode_count unique (mode_id, vertex_id) pairs; every F has the same dimensions as P and every declared mode_id occurs.",
    "Every admissible interval matrix belongs to the convex hull of the enumerated vertices and every admissible timing/packet pattern maps to one frozen mode_id.",
    "The checker verifies F^T P F <= lambda^2 P for every vertex and mode with the declared positive margin.",
    "The checker verifies lambda * invariant_radius_P_norm + disturbance_P_norm_bound <= invariant_radius_P_norm.",
    "The checker verifies command magnitude remains inside signed PWM limits after reserving quantisation and command safety margins over the full invariant set.",
    "Calibration, identification, confirmation and primary run ID sets are pairwise disjoint and their manifest is frozen before fitting.",
    "No confirmation or primary sample is used for model-order, parameter, gain, bound, margin, tail-window or endpoint selection.",
    "The primary run list equals the Cartesian product of frozen profiles, loads, blocks and three arms, with no outcome-based deletions.",
    "required_fields contains every field listed in PROTOCOL_MATH.md Section 14, with units and data types fixed in the hashed field dictionary.",
    "No result, observed metric, p-value, confidence interval, success flag or post-run estimate is permitted in the preregistration parameter file.",
    "If hard_disturbance_bound_basis is finite_sample_probabilistic_only, probabilistic_coverage_level is numeric and deterministic physical theorem wording is prohibited; if the basis is engineering_specification_plus_set_membership, the field equals not_applicable_deterministic.",
    "canonical_parameter_payload_sha256 is computed from canonical JSON after removing only freeze.canonical_parameter_payload_sha256; the external manifest also hashes the complete file.",
    "The github_commit is the v1.1.0 release commit; the fork diff against that commit must be archived.",
    "software_redistribution_basis must be supported by the hashed evidence; the hardware CERN-OHL-P-2.0 label alone is not accepted as a software redistribution licence.",
    "Any schema-valid file still fails preregistration if a semantic check above is false."
  ]
}
