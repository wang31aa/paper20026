        "raw_logs_release",
        "firmware_source_release",
        "compiled_binary_release",
        "certificate_checker_release",
        "clean_clone_command",
        "manifest_sha256"
      ],
      "properties": {
        "repository_uri": {
          "type": "string",
          "format": "uri"
        },
        "license_code": {
          "type": "string",
          "minLength": 1
        },
        "license_data": {
          "type": "string",
          "minLength": 1
        },
        "raw_logs_release": {
          "const": true
        },
        "firmware_source_release": {
          "const": true
        },
        "compiled_binary_release": {
          "const": true
        },
        "certificate_checker_release": {
          "const": true
        },
        "clean_clone_command": {
          "type": "string",
          "minLength": 1
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
